## === Base: Visual Studio rules (from GitHub) ===
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
**/[Bb]in/*

# Visual Studio cache/options
.vs/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# NuGet packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Node / npm
node_modules/

# Azure / publish
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/
AppPackages/
BundleArtifacts/

# Others
*.pfx
*.publishsettings
*.dbmdl
*.bak
*.log

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History
.history/
.vshistory/

# Installer
*.msi
*.msm
*.msp

## === Custom Rules for TryBeta Project ===

# NuGet legacy package config
TryBeta/packages.config

# Frontend libraries from NuGet (不要 commit)
TryBeta/Content/bootstrap*
TryBeta/Scripts/bootstrap*
TryBeta/Scripts/jquery*
TryBeta/Scripts/modernizr-*.js

# API keys / secrets
TryBeta/OpenAISettings.json
TryBeta/NewebPaySettings.config
webconnect.config

# 不跟蹤套件檔案
/packages/
/TryBeta/Scripts/
/TryBeta/Content/